---
/**
 * Notion-style “Up next” pagination for article pages.
 */
import { Icon } from '@astrojs/starlight/components';

const { dir, pagination } = Astro.locals.starlightRoute;
const { prev, next } = pagination;
const isRtl = dir === 'rtl';
---

{
	(prev || next) && (
		<div class="notion-pager print:hidden" dir={dir}>
			{prev && (
				<a class="notion-pager__link notion-pager__link--prev" href={prev.href} rel="prev">
					<span class="notion-pager__eyebrow">
						<Icon name={isRtl ? 'right-arrow' : 'left-arrow'} size="0.9rem" />
						Previous
					</span>
					<span class="notion-pager__title">{prev.label}</span>
				</a>
			)}
			{next && (
				<a class="notion-pager__link notion-pager__link--next" href={next.href} rel="next">
					<span class="notion-pager__eyebrow">
						Up next
						<Icon name={isRtl ? 'left-arrow' : 'right-arrow'} size="0.9rem" />
					</span>
					<span class="notion-pager__title">{next.label}</span>
					<span class="notion-pager__hint">Read more</span>
				</a>
			)}
		</div>
	)
}

<style>
	.notion-pager {
		display: grid;
		gap: 0.85rem;
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--help-border, #e3e3e0);
	}

	@media (min-width: 50rem) {
		.notion-pager {
			grid-template-columns: 1fr 1fr;
		}
		.notion-pager__link--next:only-child {
			grid-column: 2;
		}
	}

	.notion-pager__link {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1.15rem 1.25rem;
		border: 1px solid var(--help-border, #e3e3e0);
		border-radius: 12px;
		text-decoration: none;
		color: inherit;
		background: var(--sl-color-bg);
		transition: background 0.15s ease, border-color 0.15s ease;
	}

	.notion-pager__link:hover {
		background: var(--help-card, #f7f7f5);
		border-color: color-mix(in srgb, var(--sl-color-accent) 35%, var(--help-border, #e3e3e0));
	}

	.notion-pager__link--next {
		align-items: flex-end;
		text-align: end;
	}

	.notion-pager__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--help-muted, #5f5e5a);
		text-transform: none;
	}

	.notion-pager__title {
		font-size: 1.15rem;
		font-weight: 650;
		letter-spacing: -0.02em;
		line-height: 1.3;
		color: var(--sl-color-white);
	}

	.notion-pager__hint {
		font-size: 0.875rem;
		color: var(--sl-color-accent);
		font-weight: 500;
	}
</style>
